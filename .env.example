# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string (pooled). Without it the app runs on an
# in-memory database that is re-seeded on every start (fine for local dev).
DATABASE_URL=

# Google AI Studio key (free tier). Without it every check runs with local
# rules only, and the trust strip says "Checked locally".
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model ID used through the Vercel AI SDK.
LLM_MODEL=gemini-3.8-flash
